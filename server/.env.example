# Port the server listens on
PORT=4000

# Comma-separated list of allowed client origins (CORS + Socket.io).
# Required in production — wildcards (*) are rejected when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173

# Max simultaneous WebSocket connections per IP address. Generous on purpose:
# a group on one venue's Wi-Fi shares a single address.
MAX_CONNECTIONS_PER_IP=60

# Header your hosting proxy sets to the real client IP, for per-IP limits.
# On Render (behind Cloudflare) use cf-connecting-ip. Only set it if EVERY
# request goes through that proxy, otherwise clients can fake it. Unset: the
# last X-Forwarded-For entry is used.
# CLIENT_IP_HEADER=cf-connecting-ip

# Comma-separated account emails that can use the moderation queue (/admin):
# review reported posts/map reports, hide or restore them, suspend accounts.
# ADMIN_EMAILS=you@example.com

# How long (ms) a presence record stays active without an update before it
# is automatically removed.
PRESENCE_TTL_MS=300000

# How often (ms) the server sweeps for and removes expired presence records.
SWEEP_INTERVAL_MS=5000

# Minimum spacing (ms) between accepted location updates from one socket.
# Updates that arrive faster are rejected (rate limiting).
MIN_UPDATE_INTERVAL_MS=2000

# Set to "production" in deployment so the server expects HTTPS/WSS termination.
# Production template: see .env.production (copy to .env on the host).
NODE_ENV=development

# ─────────────────────────── Accounts & data ───────────────────────────

# SQLite database file. Created on first boot. It MUST be on a persistent disk
# in production (Render: add a Disk and point this at it, e.g.
# /var/data/safesips.db). Without one, every deploy or restart wipes all
# accounts, reports, friends, contacts and check-ins.
DATABASE_PATH=./data/safesips.db

# Clerk secret key (sk_test_… / sk_live_…). Required for browser sign-in.
# Copy from the Clerk Dashboard or from the web app's .env.local.
CLERK_SECRET_KEY=

# Clerk secret key (server only). Required to verify browser/mobile sessions.
# Never expose this to the web or mobile clients.
CLERK_SECRET_KEY=
# Optional: comma-separated origins allowed in the Clerk JWT azp claim.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# JWT signing secret. Still used for check-in hashing and smoke-test tokens.
# REQUIRED in production (server refuses to boot without it).
# Generate one with: openssl rand -hex 32
JWT_SECRET=
# Optional: dedicated key for hashing IPs and throttle emails (HMAC). Falls back
# to a key derived from JWT_SECRET. Changing it only resets short-lived
# rate-limit counters.
# HASH_PEPPER=
# Days a login token stays valid.
JWT_TTL_DAYS=7
# bcrypt cost factor for password/answer hashing.
BCRYPT_ROUNDS=11

# Failed-auth throttle (per email + per IP): N fails per window → 429.
AUTH_MAX_FAILS=6
AUTH_FAIL_WINDOW_MS=900000

# Hours an email-verification link stays valid.
EMAIL_TOKEN_TTL_HOURS=24

# Public URL of the web app — used to build email verification links.
WEB_APP_URL=http://localhost:5173

# SMTP — set these to send REAL verification emails. (Missed check-ins are
# never emailed: contacts are alerted inside SafeSips.) When SMTP_HOST is
# empty, verification links are only logged (dev). Works with any SMTP provider
# (Gmail, SendGrid, Mailgun, Resend, Postmark, …).
#   Gmail example: host=smtp.gmail.com port=465 secure=true user=you@gmail.com
#                  pass=<16-char app password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# "From" address shown to recipients.
EMAIL_FROM=SafeSips <safesipss@gmail.com>

# Notifications (check-in prompts + missed-check-in alerts) use Web Push. No
# setup needed: the server generates its VAPID keys once and keeps them in the
# database. Set these only to pin specific keys (generate with
# `npx web-push generate-vapid-keys`) or a contact for push services.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:safesipss@gmail.com

# Optional anti-bot: Cloudflare Turnstile secret key. When set, registration
# and the waitlist verify the Turnstile token server-side. When empty, only the
# built-in throttle + email verification are used.
TURNSTILE_SECRET=

# How often (ms) the check-in scheduler sweeps for due/overdue check-ins.
CHECKIN_SWEEP_INTERVAL_MS=15000

# Dev/CI only: when "1", exposes GET /api/test-token for smoke tests. Ignored
# in production. Never set this in a real deployment.
ALLOW_TEST_TOKEN=0
