# Production server settings. Copy to .env on the host or load via your platform.
NODE_ENV=production
PORT=4000

# Explicit HTTPS origins only — wildcards are rejected in production.
# Include every web origin you actually open (custom domain + Netlify URL if used).
CORS_ORIGINS=https://safesips.org,https://www.safesips.org,https://app.safesips.org

PRESENCE_TTL_MS=300000
SWEEP_INTERVAL_MS=5000
MIN_UPDATE_INTERVAL_MS=2000
MAX_CONNECTIONS_PER_IP=20

# Accounts & data. The DB path must point at a persistent volume.
DATABASE_PATH=/data/safesips.db

# REQUIRED: set a strong secret on the host (do NOT commit it).
# openssl rand -hex 32
JWT_SECRET=
JWT_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Clerk secret key (sk_live_…). Required for browser sign-in.
CLERK_SECRET_KEY=

AUTH_MAX_FAILS=6
AUTH_FAIL_WINDOW_MS=900000
EMAIL_TOKEN_TTL_HOURS=24

# Public web app origin (for verification links).
WEB_APP_URL=https://app.safesips.org

# SMTP — required to send verification emails AND SOS check-in alerts in
# production. Without it, missed check-ins are recorded but nobody is emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SafeSips <no-reply@safesips.org>

# SMS alerts for missed check-ins (Twilio). Leave blank to disable texts; the
# check-ins page then tells users contacts are alerted by email only.
# Twilio console -> Account Info: Account SID + Auth Token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: an alphanumeric ID such as SafeSips (supported for Romania), or a
# Twilio phone number in +E.164 form. Or use a Messaging Service instead.
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Cost / abuse limits (rolling 24 h).
SMS_DAILY_LIMIT=300
SMS_MAX_PER_NUMBER_PER_DAY=6
SMS_TESTS_PER_USER_PER_DAY=3

# Optional: enable Cloudflare Turnstile by setting the secret on the host.
TURNSTILE_SECRET=

CHECKIN_SWEEP_INTERVAL_MS=15000
