# Netlify response headers.

# Security headers for every page. frame-ancestors / X-Frame-Options stop
# other sites from embedding SafeSips to trick people into tapping "Share" or
# "Delete account" (clickjacking). Geolocation is only for SafeSips itself.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

# The service worker must always be revalidated, or users can be stuck on an
# old worker (and old offline copy) for up to 24 h.
/sw.js
  Cache-Control: no-cache

# Hashed build output never changes; cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
