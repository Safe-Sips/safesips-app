# URL of the SafeSips real-time presence server (use https:// in production).
# Used for both the Socket.io connection and the REST API (/api/*).
VITE_SERVER_URL=http://localhost:4000

# Optional: base URL of the REST API if it differs from VITE_SERVER_URL.
# Defaults to VITE_SERVER_URL when unset.
# VITE_API_URL=http://localhost:4000

# Clerk publishable key (safe for the browser). Never put CLERK_SECRET_KEY here.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional anti-bot: Cloudflare Turnstile site key. When set, the waitlist
# form renders the Turnstile widget. When empty, no widget is shown.
# VITE_TURNSTILE_SITEKEY=

# Clerk publishable key (pk_test_… / pk_live_…). Required for sign-in.
# On Render: safesips-web → Environment (build-time: redeploy after changing it).
# VITE_CLERK_PUBLISHABLE_KEY=

# Map tiles. Defaults to openstreetmap.org, whose usage policy only allows
# light use: set a tile provider (MapTiler, Stadia Maps, …) before launch.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Production values live in .env.production (used automatically by `vite build`).
