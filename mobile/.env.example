# URL of the SafeSips real-time presence server (use wss:// / https in production).
# For a device on the same network, use your machine's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_SERVER_URL=http://localhost:4000

# Clerk publishable key (safe for the client). Never put CLERK_SECRET_KEY here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
