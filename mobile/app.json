{
  "expo": {
    "name": "SafeSips",
    "slug": "safesips",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safesips",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "softwareKeyboardLayoutMode": "resize",
    "splash": {
      "backgroundColor": "#e6eaf6"
    },
    "ios": {
      "bundleIdentifier": "app.safesips.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SafeSips uses your location only to create a private, approximate 200 m area. Your exact position stays on your device."
      }
    },
    "android": {
      "package": "app.safesips.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafeSips uses your location only to create a private, approximate 200 m area. Your exact position stays on your device."
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
